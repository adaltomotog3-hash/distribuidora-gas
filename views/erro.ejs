<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
</head>
<body>
  <div class="pagina-login">
    <div class="caixa-login" style="text-align:center;">
      <div class="marca-login">
        <img src="/img/logo-td.png" alt="Logo" class="logo-login">
      </div>
      <div style="font-family:'Sora',sans-serif; font-size:44px; font-weight:800; color:var(--chama); line-height:1;"><%= codigo %></div>
      <p style="color:var(--texto-suave); font-size:14.5px; margin:12px 0 22px 0;"><%= mensagem %></p>
      <a class="botao" href="/" style="width:100%; display:block;">Voltar pro painel</a>
    </div>
  </div>
</body>
</html>
