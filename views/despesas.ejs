<%
  var nomesFormaPagamento = { dinheiro: 'Dinheiro', pix: 'Pix', cartao: 'Cartão' };
  var iconesFormaPagamento = { dinheiro: '💵', pix: '📱', cartao: '💳' };
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Despesas' }) %>
</head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { paginaAtual: 'despesas' }) %>

    <div class="conteudo">

      <%- include('partials/flash') %>
      <div class="topo-pagina">
        <div>
          <h1>Despesas</h1>
          <p>Registre tudo que saiu de dinheiro — o valor é descontado na hora do saldo da forma de pagamento usada</p>
        </div>
      </div>

      <div class="painel">
        <div class="painel-titulo">Registrar despesa</div>
        <form method="POST" action="/despesas" class="form-grade" enctype="multipart/form-data" style="padding:20px;">
          <div>
            <label>Descrição</label>
            <input type="text" name="descricao" placeholder="Ex: Compra de material de limpeza" required>
          </div>
          <div>
            <label>Valor</label>
            <input type="text" inputmode="decimal" name="valor" placeholder="0,00" required>
          </div>
          <div>
            <label>De onde saiu o dinheiro</label>
            <select name="forma_pagamento" required>
              <option value="" disabled selected>Selecione...</option>
              <option value="dinheiro">💵 Dinheiro</option>
              <option value="pix">📱 Pix</option>
              <option value="cartao">💳 Cartão</option>
            </select>
          </div>
          <div>
            <label>Para onde foi / pra quem foi pago</label>
            <input type="text" name="destino" placeholder="Ex: Posto Ipiranga, Fornecedor João">
          </div>
          <div>
            <label>Motivo</label>
            <input type="text" name="motivo" placeholder="Ex: Combustível, manutenção, produto de limpeza">
          </div>
          <div style="grid-column: 1 / -1;">
            <label>Comprovante (foto ou PDF)</label>
            <input type="file" id="input-comprovantes" name="comprovantes" accept="image/*,application/pdf" multiple>
            <div id="lista-arquivos-selecionados" class="texto-suave" style="font-size:12.5px; margin-top:6px;"></div>
            <p class="texto-suave" style="font-size:11.5px; margin-top:4px;">Pode anexar mais de um arquivo (até 5, 10MB cada).</p>
          </div>
          <div class="form-acoes">
            <button class="botao" type="submit">Registrar despesa</button>
          </div>
        </form>
      </div>

      <div class="painel">
        <form method="GET" action="/despesas" class="form-grade">
          <div>
            <label>De</label>
            <input type="date" name="inicio" value="<%= dataInicio %>">
          </div>
          <div>
            <label>Até</label>
            <input type="date" name="fim" value="<%= dataFim %>">
          </div>
          <div class="form-acoes">
            <button class="botao" type="submit">Filtrar período</button>
          </div>
        </form>
      </div>

      <div class="grade-cards">
        <div class="card destaque-vermelho">
          <div class="rotulo">Total de despesas no período</div>
          <div class="valor">R$ <%= Number(totalPeriodo).toFixed(2) %></div>
        </div>
        <div class="card">
          <div class="rotulo">Qtd. de despesas</div>
          <div class="valor"><%= despesas.length %></div>
        </div>
      </div>

      <div class="painel">
        <div class="painel-titulo">Despesas do período (<%= despesas.length %>)</div>
        <% if (despesas.length === 0) { %>
          <div class="vazio-lista">Nenhuma despesa registrada nesse período.</div>
        <% } else { %>
          <div class="painel-tabela-rolagem">
          <table>
            <thead>
              <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Para onde foi</th>
                <th>Motivo</th>
                <th>Saiu de</th>
                <th>Valor</th>
                <th>Lançado por</th>
                <th>Comprovante</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% despesas.forEach(function(d) { %>
                <tr>
                  <td class="texto-suave"><%= new Date(d.criado_em).toLocaleString('pt-BR') %></td>
                  <td><%= d.descricao %></td>
                  <td class="texto-suave"><%= d.destino || '—' %></td>
                  <td class="texto-suave"><%= d.motivo || '—' %></td>
                  <td>
                    <%= iconesFormaPagamento[d.forma_pagamento] || '' %>
                    <%= nomesFormaPagamento[d.forma_pagamento] || d.forma_pagamento %>
                  </td>
                  <td><strong>R$ <%= Number(d.valor).toFixed(2) %></strong></td>
                  <td class="texto-suave"><%= d.registrado_por || '—' %></td>
                  <td>
                    <% if (d.comprovantes.length === 0) { %>
                      <span class="texto-suave">—</span>
                    <% } else { %>
                      <div style="display:flex; flex-direction:column; gap:4px;">
                        <% d.comprovantes.forEach(function(c, indice) { %>
                          <div style="display:flex; align-items:center; gap:6px;">
                            <a href="/despesas/comprovantes/<%= c.id %>" target="_blank">📎 Comprovante <%= indice + 1 %></a>
                            <form method="POST" action="/despesas/comprovantes/<%= c.id %>/excluir" class="excluir-comprovante-form">
                              <button class="botao-perigo botao-pequeno" type="submit" style="border:none; background:transparent; padding:0 4px;">✕</button>
                            </form>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <form method="POST" action="/despesas/<%= d.id %>/excluir" class="excluir-despesa-form">
                      <button class="botao botao-perigo botao-pequeno" type="submit">Excluir</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    var inputComprovantes = document.getElementById('input-comprovantes');
    if (inputComprovantes) {
      inputComprovantes.addEventListener('change', function () {
        var lista = document.getElementById('lista-arquivos-selecionados');
        if (!this.files || this.files.length === 0) {
          lista.textContent = '';
          return;
        }
        var nomes = Array.prototype.map.call(this.files, function (arquivo) {
          return arquivo.name;
        });
        lista.textContent = '📎 ' + nomes.length + ' arquivo' + (nomes.length > 1 ? 's' : '') + ' selecionado' + (nomes.length > 1 ? 's' : '') + ': ' + nomes.join(', ');
      });
    }

    document.querySelectorAll('.excluir-despesa-form').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (form.dataset.enviando) return;
        if (!confirm('Excluir essa despesa? Essa ação não pode ser desfeita.')) {
          e.preventDefault();
          return;
        }
        form.dataset.enviando = '1';
      });
    });

    document.querySelectorAll('.excluir-comprovante-form').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (form.dataset.enviando) return;
        if (!confirm('Remover esse comprovante?')) {
          e.preventDefault();
          return;
        }
        form.dataset.enviando = '1';
      });
    });
  </script>
</body>
</html>
