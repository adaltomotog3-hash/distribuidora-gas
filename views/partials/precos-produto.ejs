<div class="grupo-preco">
  <div class="grupo-preco-nome"><%= grupo.nome %></div>
  <table class="tabela-precos">
    <thead>
      <tr>
        <th>Tipo de venda</th>
        <th>Descrição</th>
        <th>Preço atual</th>
        <th>Atualizar</th>
      </tr>
    </thead>
    <tbody>
      <% grupo.precos.forEach(function(p) { %>
        <tr>
          <td><%= p.tipo_venda === 'troca' ? 'Com troca' : 'Sem troca' %></td>
          <td class="texto-suave"><%= p.descricao %></td>
          <td>R$ <%= Number(p.preco).toFixed(2) %></td>
          <td>
            <form method="POST" action="/precos/<%= p.produto_id %>/<%= p.tipo_venda %>" style="display:flex; gap:8px;">
              <input type="number" step="0.01" min="0" name="preco" value="<%= p.preco %>" style="max-width:120px">
              <button class="botao botao-pequeno" type="submit">Salvar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
