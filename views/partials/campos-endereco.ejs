<%
  const _c = (typeof cliente !== 'undefined' && cliente) ? cliente : {};
%>
<div>
  <label>CEP</label>
  <div style="display:flex; gap:8px;">
    <input type="text" name="cep" id="campo-cep" value="<%= _c.cep || '' %>" placeholder="00000-000" maxlength="9">
    <button type="button" class="botao botao-secundario botao-pequeno" onclick="buscarCep()">Buscar</button>
  </div>
</div>
<div>
  <label>Endereço (rua)</label>
  <input type="text" name="endereco" id="campo-endereco" value="<%= _c.endereco || '' %>">
</div>
<div>
  <label>Número</label>
  <input type="text" name="numero" id="campo-numero" value="<%= _c.numero || '' %>">
</div>
<div>
  <label>Complemento</label>
  <input type="text" name="complemento" id="campo-complemento" value="<%= _c.complemento || '' %>" placeholder="Bloco, apto, ponto comercial...">
</div>
<div>
  <label>Bairro</label>
  <input type="text" name="bairro" id="campo-bairro" value="<%= _c.bairro || '' %>">
</div>
<div>
  <label>Cidade</label>
  <input type="text" name="cidade" id="campo-cidade" value="<%= _c.cidade || '' %>">
</div>
<div>
  <label>UF</label>
  <input type="text" name="uf" id="campo-uf" value="<%= _c.uf || '' %>" maxlength="2" style="text-transform:uppercase;">
</div>
<div>
  <label>Referência</label>
  <input type="text" name="referencia" id="campo-referencia" value="<%= _c.referencia || '' %>" placeholder="Ex: perto do mercado tal">
</div>
<div style="grid-column: 1 / -1;">
  <label>Localização no mapa (usada na entrega)</label>
  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
    <input type="text" name="latitude" id="campo-latitude" value="<%= _c.latitude || '' %>" placeholder="Latitude" style="max-width:150px;">
    <input type="text" name="longitude" id="campo-longitude" value="<%= _c.longitude || '' %>" placeholder="Longitude" style="max-width:150px;">
    <button type="button" class="botao botao-secundario botao-pequeno" onclick="abrirMapaEndereco()">📍 Marcar no mapa</button>
  </div>
</div>
