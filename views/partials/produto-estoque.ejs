<div class="card-produto-estoque">
  <div class="card-produto-cabecalho">
    <div class="nome-produto-estoque">
      <%= produto.nome %>
      <% if (produto.ncm && produto.cfop && produto.cst_csosn) { %>
        <br><span class="selo selo-fiscal-ok" title="NCM, CFOP e CST/CSOSN preenchidos">Fiscal ok</span>
      <% } else { %>
        <br><span class="selo selo-fiscal-pendente" title="Faltam NCM, CFOP ou CST/CSOSN — o contador define">Fiscal pendente</span>
      <% } %>
    </div>
    <div class="card-produto-quantidades">
      <div class="qtd-bloco qtd-bloco-cheio">
        <div class="qtd-numero"><%= produto.qtd_cheios %></div>
        <div class="qtd-rotulo">Cheios</div>
      </div>
      <div class="qtd-bloco qtd-bloco-vazio">
        <div class="qtd-numero"><%= produto.qtd_vazios %></div>
        <div class="qtd-rotulo">Vazios</div>
      </div>
    </div>
    <button class="botao botao-secundario botao-pequeno" type="button" data-abrir-detalhe="<%= produto.id %>">Gerenciar</button>
  </div>

  <div class="card-produto-detalhe" id="detalhe-<%= produto.id %>" style="display:none;">
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
      <form method="POST" action="/estoque/produtos/<%= produto.id %>/desativar" onsubmit="return confirm('Desativar \'<%= produto.nome %>\'? Ele some da lista de venda, mas o histórico continua salvo.');" style="display:inline;">
        <button class="botao botao-secundario botao-pequeno" type="submit">Desativar produto</button>
      </form>
    </div>

    <div class="form-grade" style="padding:0; margin-bottom:12px;">
      <form method="POST" action="/estoque/produtos/<%= produto.id %>/editar" style="display:contents;">
        <div>
          <label>Nome do produto</label>
          <input type="text" name="nome" value="<%= produto.nome %>" required>
        </div>
        <div class="form-acoes" style="grid-column:auto;">
          <button class="botao botao-secundario botao-pequeno" type="submit">Salvar nome</button>
        </div>
      </form>
    </div>

    <div class="form-grade" style="padding:0; margin-bottom:12px;">
      <form method="POST" action="/estoque/produtos/<%= produto.id %>/corrigir" style="display:contents;">
        <div>
          <label>Corrigir cheios</label>
          <input type="number" min="0" name="qtd_cheios" value="<%= produto.qtd_cheios %>">
        </div>
        <div>
          <label>Corrigir vazios</label>
          <input type="number" min="0" name="qtd_vazios" value="<%= produto.qtd_vazios %>">
        </div>
        <div class="form-acoes" style="grid-column:auto;">
          <button class="botao botao-secundario botao-pequeno" type="submit">Salvar quantidade</button>
        </div>
      </form>
    </div>

    <details class="fiscal-produto-form" style="margin-bottom:12px;">
      <summary class="texto-suave" style="cursor:pointer;">Dados fiscais (nota fiscal — preencher com o contador)</summary>
      <form method="POST" action="/estoque/produtos/<%= produto.id %>/fiscal" class="form-grade" style="padding:12px 0 0;">
        <div>
          <label>NCM (8 dígitos)</label>
          <input type="text" name="ncm" value="<%= produto.ncm || '' %>" maxlength="10" inputmode="numeric">
        </div>
        <div>
          <label>CFOP (4 dígitos)</label>
          <input type="text" name="cfop" value="<%= produto.cfop || '' %>" maxlength="5" inputmode="numeric">
        </div>
        <div>
          <label><%= (typeof usaCsosn === 'undefined' || usaCsosn) ? 'CSOSN (3 dígitos)' : 'CST (2 dígitos)' %></label>
          <input type="text" name="cst_csosn" value="<%= produto.cst_csosn || '' %>" maxlength="3" inputmode="numeric">
        </div>
        <div>
          <label>Origem (0 a 8)</label>
          <input type="text" name="origem" value="<%= produto.origem || '0' %>" maxlength="1" inputmode="numeric">
        </div>
        <div>
          <label>Unidade (ex: UN)</label>
          <input type="text" name="unidade_comercial" value="<%= produto.unidade_comercial || 'UN' %>" maxlength="6" style="text-transform:uppercase;">
        </div>
        <div>
          <label>CEST (opcional, 7 dígitos)</label>
          <input type="text" name="cest" value="<%= produto.cest || '' %>" maxlength="9" inputmode="numeric">
        </div>
        <div class="form-acoes" style="grid-column:auto;">
          <button class="botao botao-secundario botao-pequeno" type="submit">Salvar dados fiscais</button>
        </div>
      </form>
    </details>

    <details>
      <summary class="texto-suave" style="cursor:pointer;">Registrar entrada/saída (compra do fornecedor, devolução de vazio)</summary>
      <div style="margin-top:10px; display:flex; flex-direction:column; gap:10px;">
        <form method="POST" action="/estoque/produtos/<%= produto.id %>/entrada-cheio" class="form-grade">
          <div>
            <label>Entrada de cheios (compra do fornecedor)</label>
            <input type="number" min="1" name="quantidade">
          </div>
          <div>
            <label>Observação</label>
            <input type="text" name="observacao">
          </div>
          <div class="form-acoes">
            <button class="botao botao-secundario botao-pequeno" type="submit">Registrar entrada</button>
          </div>
        </form>
        <form method="POST" action="/estoque/produtos/<%= produto.id %>/entrada-vazio" class="form-grade">
          <div>
            <label>Adicionar vazios</label>
            <input type="number" min="1" name="quantidade">
          </div>
          <div>
            <label>Observação</label>
            <input type="text" name="observacao">
          </div>
          <div class="form-acoes">
            <button class="botao botao-secundario botao-pequeno" type="submit">Adicionar vazios</button>
          </div>
        </form>
        <form method="POST" action="/estoque/produtos/<%= produto.id %>/saida-vazio" class="form-grade">
          <div>
            <label>Retirar vazios (ex: devolvidos ao fornecedor)</label>
            <input type="number" min="1" name="quantidade">
          </div>
          <div>
            <label>Observação</label>
            <input type="text" name="observacao">
          </div>
          <div class="form-acoes">
            <button class="botao botao-secundario botao-pequeno" type="submit">Retirar vazios</button>
          </div>
        </form>
      </div>
    </details>
  </div>
</div>
