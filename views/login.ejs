<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Entrar' }) %>
</head>
<body>
  <div class="pagina-login">
    <div class="caixa-login">
      <div class="marca-login">
        <img src="/img/lorin-logo.png" alt="Lorin Gás e Água" class="logo-login">
        <p class="subtitulo-login">Painel administrativo</p>
      </div>

      <% if (erro) { %>
        <div class="erro-login">⚠️ <%= erro %></div>
      <% } %>

      <form method="POST" action="/login">
        <label for="username">Usuário</label>
        <input type="text" id="username" name="username" required autofocus autocomplete="username" style="margin-bottom:14px">

        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" required autocomplete="current-password" style="margin-bottom:22px">

        <button class="botao botao-login" type="submit">Entrar</button>
      </form>
    </div>
    <div class="rodape-login">Lorin Gás e Água — Sistema de Gestão</div>
  </div>
</body>
</html>
