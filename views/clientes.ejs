<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Clientes' }) %>
</head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { paginaAtual: 'clientes' }) %>

    <div class="conteudo">

      <%- include('partials/flash') %>
      <div class="topo-pagina">
        <div>
          <h1>Clientes</h1>
          <p>Cadastro dos seus clientes</p>
        </div>
      </div>

      <div class="painel">
        <div class="painel-titulo">Novo cliente</div>
        <form method="POST" action="/clientes" class="form-grade">
          <div>
            <label>Nome</label>
            <input type="text" name="nome" required>
          </div>
          <div>
            <label>Telefone</label>
            <input type="text" name="telefone">
          </div>
          <div>
            <label>CPF / CNPJ (para nota fiscal)</label>
            <input type="text" name="cpf_cnpj" placeholder="Opcional" maxlength="18" inputmode="numeric">
          </div>
          <div>
            <label>E-mail (para enviar a nota)</label>
            <input type="email" name="email" placeholder="Opcional">
          </div>
          <div>
            <label>Inscrição estadual (só se for empresa)</label>
            <input type="text" name="inscricao_estadual" placeholder="Opcional">
          </div>
          <%- include('partials/campos-endereco') %>
          <div style="grid-column: 1 / -1;">
            <label>Observação</label>
            <input type="text" name="observacao">
          </div>
          <div class="form-acoes">
            <button class="botao" type="submit">Cadastrar cliente</button>
          </div>
        </form>
      </div>

      <div class="painel">
        <div class="painel-titulo">Todos os clientes (<%= clientes.length %>)</div>
        <% if (clientes.length === 0) { %>
          <div class="vazio-lista">Nenhum cliente cadastrado ainda.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CPF/CNPJ</th>
                <th>Endereço</th>
                <th>Observação</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% clientes.forEach(function(c) { %>
                <tr>
                  <td><%= c.nome %></td>
                  <td><%= c.telefone || '—' %></td>
                  <td class="texto-suave"><%= c.cpf_cnpj ? formatarCpfCnpj(c.cpf_cnpj) : '—' %></td>
                  <td class="texto-suave"><%= c.endereco_formatado || '—' %><%= (c.latitude && c.longitude) ? ' 📍' : '' %></td>
                  <td class="texto-suave"><%= c.observacao || '—' %></td>
                  <td style="display:flex; gap:8px;">
                    <a class="botao botao-secundario botao-pequeno" href="/clientes/<%= c.id %>/editar">Editar</a>
                    <form method="POST" action="/clientes/<%= c.id %>/excluir" onsubmit="return confirm('Excluir este cliente?');">
                      <button class="botao botao-secundario botao-pequeno" type="submit">Excluir</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('partials/mapa-endereco') %>
</body>
</html>
