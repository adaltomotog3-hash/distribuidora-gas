<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Rastreio' }) %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    #mapa { width: 100%; height: 560px; border-radius: var(--raio); border: 1px solid var(--borda); }
    .legenda { display: flex; gap: 18px; margin-bottom: 14px; font-size: 13px; color: var(--texto-suave); flex-wrap: wrap; }
    .legenda span { display: inline-flex; align-items: center; gap: 6px; }
    .ponto { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  </style>
</head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { paginaAtual: 'rastreio' }) %>

    <div class="conteudo">

      <%- include('partials/flash') %>
      <div class="topo-pagina">
        <div>
          <h1>Rastreio</h1>
          <p>Localização do entregador em tempo real e entregas finalizadas hoje</p>
        </div>
      </div>

      <div class="painel" style="padding:20px;">
        <div class="legenda">
          <span><span class="ponto" style="background:#F4772E"></span> Entregador (posição atual)</span>
          <span><span class="ponto" style="background:#2E9E5B"></span> Entrega de gás finalizada</span>
          <span><span class="ponto" style="background:#2B7DE9"></span> Entrega de água finalizada</span>
          <span><span class="ponto" style="background:#8A5CF6"></span> Pedido com gás + água finalizado</span>
        </div>
        <div id="mapa"></div>
        <div id="status-atualizacao" class="texto-suave" style="margin-top:10px; font-size:12.5px;">Carregando...</div>
      </div>

      <div class="painel">
        <div class="painel-titulo">Entregas finalizadas hoje</div>
        <div id="lista-entregas-hoje">
          <div class="vazio-lista">Carregando...</div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const mapa = L.map('mapa').setView([-14.235, -51.925], 4); // centro do Brasil, até ter posição real
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
      attribution: '&copy; Esri',
      maxZoom: 19
    }).addTo(mapa);

    const