<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Relatórios' }) %>
  <style>
    .abas-relatorio { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .aba-relatorio {
      padding: 9px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600;
      border: 1px solid var(--borda); color: var(--texto-suave); background: var(--papel);
      box-shadow: var(--sombra-suave); transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .aba-relatorio:hover { border-color: #C9C6BE; color: var(--texto); }
    .aba-relatorio.ativa { background: var(--chama); color: #fff; border-color: var(--chama); box-shadow: 0 4px 12px rgba(217,96,28,0.28); }
    .aba-relatorio.ativa:hover { color: #fff; }
    .aba-relatorio.ativa.secundaria { background: var(--azul-noite); border-color: var(--azul-noite); box-shadow: 0 4px 12px rgba(27,36,48,0.25); }
  </style>
</head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { paginaAtual: 'relatorios' }) %>

    <div class="conteudo">

      <%- include('partials/flash') %>
      <div class="topo-pagina">
        <div>
          <h1>Relatórios</h1>
          <p>Acompanhe as vendas, o financeiro e as entregas por período — diário, semanal, quinzenal, mensal ou anual</p>
        </div>
      </div>

      <div class="abas-relatorio">
        <a class="aba-relatorio <%= tipo === 'vendas' ? 'ativa' : '' %>" href="/relatorios?tipo=vendas&periodo=<%= periodo %>">📦 Relatório de Vendas</a>
        <a class="aba-relatorio <%= tipo === 'financeiro' ? 'ativa' : '' %>" href="/relatorios?tipo=financeiro&periodo=<%= periodo %>">💰 Relatório Financeiro</a>
        <a class="aba-relatorio <%= tipo === 'entregas' ? 'ativa' : '' %>" href="/relatorios?tipo=entregas&periodo=<%= periodo %>">🛵 Relatório de Entregas</a>
        <a class="aba-relatorio <%= tipo === 'saidas' ? 'ativa' : '' %>" href="/relatorios?tipo=saidas&periodo=<%= periodo %>">💸 Relatório de Saídas</a>
      </div>

      <div class="abas-relatorio">
        <a class="aba-relatorio secundaria <%= periodo === 'dia' ? 'ativa' : '' %>" href="/relatorios?tipo=<%= tipo %>&periodo=dia">Diário</a>
        <a class="aba-relatorio secundaria <%= periodo === 'semana' ? 'ativa' : '' %>" href="/relatorios?tipo=<%= tipo %>&periodo=semana">Semanal</a>
        <a class="aba-relatorio secundaria <%= periodo === 'quinzena' ? 'ativa' : '' %>" href="/relatorios?tipo=<%= tipo %>&periodo=quinzena">Quinzenal</a>
        <a class="aba-relatorio secundaria <%= periodo === 'mes' ? 'ativa' : '' %>" href="/relatorios?tipo=<%= tipo %>&periodo=mes">Mensal</a>
        <a class="aba-relatorio secundaria <%= periodo === 'ano' ? 'ativa' : '' %>" href="/relatorios?tipo=<%= tipo %>&periodo=ano">Anual</a>
      </div>

      <% if (atual) { %>
        <p class="texto-suave" style="font-size:12.5px; margin: -4px 0 10px;"><%= rotuloAtual %>:</p>
        <div class="grade-cards">
          <% if (tipo === 'entregas') { %>
            <div class="card">
              <div class="rotulo">Entregas</div>
              <div class="valor"><%= atual.total_entregas %></div>
            </div>
            <div class="card destaque-verde">
              <div class="rotulo">Valor entregue</div>
              <div class="valor">R$ <%= Number(atual.valor_total).toFixed(2) %></div>
            </div>
          <% } else if (tipo === 'saidas') { %>
            <div class="card">
              <div class="rotulo">Despesas</div>
              <div class="valor"><%= atual.total_despesas %></div>
            </div>
            <div class="card destaque-vermelho">
              <div class="rotulo">Valor gasto</div>
              <div class="valor">R$ <%= Number(atual.valor_total).toFixed(2) %></div>
            </div>
          <% } else { %>
            <div class="card">
              <div class="rotulo">Pedidos (O.S.)</div>
              <div class="valor"><%= atual.total_pedidos %></div>
            </div>
            <% if (tipo === 'vendas') { %>
              <div class="card">
                <div class="rotulo">Itens vendidos</div>
                <div class="valor"><%= atual.total_itens %></div>
              </div>
              <div class="card destaque-chama">
                <div class="rotulo">🔥 Qtd. Gás</div>
                <div class="valor"><%= atual.qtd_gas %></div>
              </div>
              <div class="card">
                <div class="rotulo">💧 Qtd. Água</div>
                <div class="valor"><%= atual.qtd_agua %></div>
              </div>
            <% } else { %>
              <div class="card destaque-verde">
                <div class="rotulo">Valor total (já com desconto)</div>
                <div class="valor">R$ <%= Number(atual.valor_total).toFixed(2) %></div>
              </div>
              <div class="card">
                <div class="rotulo">Descontos concedidos</div>
                <div class="valor">R$ <%= Number(atual.total_descontos).toFixed(2) %></div>
              </div>
            <% } %>
          <% } %>
        </div>
      <% } %>

      <div class="painel">
        <div class="painel-titulo">
          <%= tipo === 'vendas' ? 'Vendas por período' : (tipo === 'financeiro' ? 'Financeiro por período' : (tipo === 'saidas' ? 'Saídas por período' : 'Entregas por período')) %>
        </div>
        <% if (linhas.length === 0) { %>
          <div class="vazio-lista">
            <% if (tipo === 'saidas') { %>Ainda não há despesas suficientes pra montar esse relatório.<% } else { %>Ainda não há pedidos <%= tipo === 'entregas' ? 'entregues' : 'fechados' %> suficientes pra montar esse relatório.<% } %>
          </div>
        <% } else { %>
          <table>
            <thead>
              <% if (tipo === 'vendas') { %>
                <tr>
                  <th>Período</th>
                  <th>Pedidos (O.S.)</th>
                  <th>Itens vendidos</th>
                  <th>Qtd. Gás</th>
                  <th>Qtd. Água</th>
                </tr>
              <% } else if (tipo === 'financeiro') { %>
                <tr>
                  <th>Período</th>
                  <th>Pedidos (O.S.)</th>
                  <th>Valor Gás</th>
                  <th>Valor Água</th>
                  <th>Descontos</th>
                  <th>Valor Total</th>
                </tr>
              <% } else if (tipo === 'saidas') { %>
                <tr>
                  <th>Período</th>
                  <th>Despesas</th>
                  <th>Valor gasto</th>
                </tr>
              <% } else { %>
                <tr>
                  <th>Período</th>
                  <th>Entregas</th>
                  <th>Valor entregue</th>
                </tr>
              <% } %>
            </thead>
            <tbody>
              <% linhas.forEach(function(l) { %>
                <tr>
                  <td style="text-transform:capitalize;"><%= l.label %></td>
                  <% if (tipo === 'vendas') { %>
                    <td><%= l.total_pedidos %></td>
                    <td><%= l.total_itens %></td>
                    <td><%= l.qtd_gas %></td>
                    <td><%= l.qtd_agua %></td>
                  <% } else if (tipo === 'financeiro') { %>
                    <td><%= l.total_pedidos %></td>
                    <td>R$ <%= Number(l.valor_gas).toFixed(2) %></td>
                    <td>R$ <%= Number(l.valor_agua).toFixed(2) %></td>
                    <td class="texto-suave">R$ <%= Number(l.total_descontos).toFixed(2) %></td>
                    <td><strong>R$ <%= Number(l.valor_total).toFixed(2) %></strong></td>
                  <% } else if (tipo === 'saidas') { %>
                    <td><%= l.total_despesas %></td>
                    <td><strong>R$ <%= Number(l.valor_total).toFixed(2) %></strong></td>
                  <% } else { %>
                    <td><%= l.total_entregas %></td>
                    <td>R$ <%= Number(l.valor_total).toFixed(2) %></td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <p class="texto-suave" style="font-size:12.5px;">
        Os cards acima mostram só <%= rotuloAtual.toLowerCase() %>. A tabela acima mostra o histórico dos últimos períodos (por exemplo, os últimos 30 dias no diário, ou os últimos 12 meses no mensal).
        Pra ver um intervalo de datas específico com todo o detalhe (e baixar em PDF), use o painel abaixo.
      </p>

      <div class="painel">
        <div class="painel-titulo">Busca detalhada por intervalo de datas</div>
        <form method="GET" action="/relatorios" class="form-grade">
          <input type="hidden" name="tipo" value="<%= tipo %>">
          <input type="hidden" name="periodo" value="<%= periodo %>">
          <div>
            <label>De</label>
            <input type="date" name="inicio" value="<%= inicio %>">
          </div>
          <div>
            <label>Até</label>
            <input type="date" name="fim" value="<%= fim %>">
          </div>
          <div class="form-acoes" style="gap:8px; display:flex; flex-wrap:wrap;">
            <button class="botao" type="submit">Filtrar período</button>
            <a class="botao botao-secundario" href="/relatorios/pdf/<%= tipo %>?inicio=<%= inicio %>&fim=<%= fim %>" target="_blank">📄 Baixar PDF detalhado</a>
          </div>
        </form>
      </div>

      <% if (tipo === 'vendas') { %>
        <div class="painel">
          <div class="painel-titulo">Detalhe das O.S. no intervalo acima (<%= detalheVendas.length %>)</div>
          <% if (detalheVendas.length === 0) { %>
            <div class="vazio-lista">Nenhuma O.S. fechada nesse período.</div>
          <% } else { %>
            <div class="painel-tabela-rolagem">
            <table>
              <thead>
                <tr>
                  <th>O.S.</th>
                  <th>Data</th>
                  <th>Cliente</th>
                  <th>Itens</th>
                  <th>Pagamento</th>
                  <th>Desconto</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <% detalheVendas.forEach(function(d) { %>
                  <tr>
                    <td><a href="/pedidos/<%= d.id %>"><span class="selo-os">Nº <%= d.id %></span></a></td>
                    <td class="texto-suave"><%= new Date(d.fechado_em).toLocaleString('pt-BR') %></td>
                    <td><%= d.cliente_nome %></td>
                    <td class="texto-suave"><%= d.resumo_itens || '—' %></td>
                    <td class="texto-suave"><%= d.forma_pagamento || '—' %></td>
                    <td class="texto-suave">R$ <%= Number(d.desconto).toFixed(2) %></td>
                    <td><strong>R$ <%= Number(d.total_valor).toFixed(2) %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (tipo === 'financeiro') { %>
        <div class="grade-cards">
          <div class="card destaque-verde">
            <div class="rotulo">Entrou no período</div>
            <div class="valor">R$ <%= porFormaFinanceiro.reduce(function(s, f) { return s + Number(f.total_valor); }, 0).toFixed(2) %></div>
          </div>
          <div class="card destaque-vermelho">
            <div class="rotulo">Saiu no período (despesas)</div>
            <div class="valor">R$ <%= Number(totalDespesasFinanceiro).toFixed(2) %></div>
          </div>
          <div class="card">
            <div class="rotulo">Saldo líquido</div>
            <div class="valor">R$ <%= Number(saldoLiquidoFinanceiro).toFixed(2) %></div>
          </div>
        </div>

        <div class="painel">
          <div class="painel-titulo">Entradas por forma de pagamento (no intervalo acima)</div>
          <% if (porFormaFinanceiro.length === 0) { %>
            <div class="vazio-lista">Nenhuma venda nesse período.</div>
          <% } else { %>
            <table>
              <thead><tr><th>Forma</th><th>Vendas</th><th>Valor</th></tr></thead>
              <tbody>
                <% var nomesFormaPagamento3 = { dinheiro: 'Dinheiro', pix: 'Pix', cartao: 'Cartão', fiado: 'Fiado' }; %>
                <% porFormaFinanceiro.forEach(function(f) { %>
                  <tr>
                    <td><%= nomesFormaPagamento3[f.forma_pagamento] || f.forma_pagamento %></td>
                    <td><%= f.total_vendas %></td>
                    <td>R$ <%= Number(f.total_valor).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="painel">
          <div class="painel-titulo">Saídas por forma de pagamento (no intervalo acima)</div>
          <% if (despesasPorFormaFinanceiro.length === 0) { %>
            <div class="vazio-lista">Nenhuma despesa nesse período.</div>
          <% } else { %>
            <table>
              <thead><tr><th>Forma</th><th>Despesas</th><th>Valor</th></tr></thead>
              <tbody>
                <% despesasPorFormaFinanceiro.forEach(function(f) { %>
                  <tr>
                    <td><%= nomesFormaPagamento3[f.forma_pagamento] || f.forma_pagamento %></td>
                    <td><%= f.total_despesas %></td>
                    <td>R$ <%= Number(f.total_valor).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="painel">
          <div class="painel-titulo">Detalhe das vendas no intervalo acima (<%= detalheVendas.length %>)</div>
          <% if (detalheVendas.length === 0) { %>
            <div class="vazio-lista">Nenhuma O.S. fechada nesse período.</div>
          <% } else { %>
            <div class="painel-tabela-rolagem">
            <table>
              <thead>
                <tr>
                  <th>O.S.</th>
                  <th>Data</th>
                  <th>Cliente</th>
                  <th>Pagamento</th>
                  <th>Desconto</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <% detalheVendas.forEach(function(d) { %>
                  <tr>
                    <td><a href="/pedidos/<%= d.id %>"><span class="selo-os">Nº <%= d.id %></span></a></td>
                    <td class="texto-suave"><%= new Date(d.fechado_em).toLocaleString('pt-BR') %></td>
                    <td><%= d.cliente_nome %></td>
                    <td class="texto-suave"><%= d.forma_pagamento || '—' %></td>
                    <td class="texto-suave">R$ <%= Number(d.desconto).toFixed(2) %></td>
                    <td><strong>R$ <%= Number(d.total_valor).toFixed(2) %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (tipo === 'entregas') { %>
        <div class="painel">
          <div class="painel-titulo">Quem entregou — por entregador (no intervalo de datas acima)</div>
          <% if (porEntregador.length === 0) { %>
            <div class="vazio-lista">Nenhuma entrega finalizada nesse período.</div>
          <% } else { %>
            <table>
              <thead><tr><th>Entregador</th><th>Entregas</th><th>Valor entregue</th></tr></thead>
              <tbody>
                <% porEntregador.forEach(function(e) { %>
                  <tr>
                    <td><%= e.entregador_nome %></td>
                    <td><%= e.total_entregas %></td>
                    <td>R$ <%= Number(e.valor_total).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="painel">
          <div class="painel-titulo">Detalhe das entregas (<%= detalhe.length %>)</div>
          <% if (detalhe.length === 0) { %>
            <div class="vazio-lista">Nenhuma entrega finalizada nesse período.</div>
          <% } else { %>
            <div class="painel-tabela-rolagem">
            <table>
              <thead>
                <tr>
                  <th>O.S.</th>
                  <th>Cliente</th>
                  <th>Itens</th>
                  <th>Total</th>
                  <th>Entregador</th>
                  <th>Entregue em</th>
                  <th>Baixa</th>
                </tr>
              </thead>
              <tbody>
                <% detalhe.forEach(function(d) { %>
                  <tr>
                    <td><a href="/pedidos/<%= d.id %>"><span class="selo-os">Nº <%= d.id %></span></a></td>
                    <td><%= d.cliente_nome %></td>
                    <td class="texto-suave"><%= d.resumo_itens || '—' %></td>
                    <td>R$ <%= Number(d.total_valor).toFixed(2) %></td>
                    <td><%= d.entregador_nome %></td>
                    <td class="texto-suave"><%= d.entregue_em ? new Date(d.entregue_em).toLocaleString('pt-BR') : '—' %></td>
                    <td>
                      <% if (d.baixado_em) { %>
                        <span class="selo selo-concluida">Baixada</span>
                      <% } else { %>
                        <span class="selo selo-aguardando">Pendente</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (tipo === 'saidas') { %>
        <div class="painel">
          <div class="painel-titulo">Por forma de pagamento — de onde saiu o dinheiro (no intervalo de datas acima)</div>
          <% if (porForma.length === 0) { %>
            <div class="vazio-lista">Nenhuma despesa nesse período.</div>
          <% } else { %>
            <table>
              <thead><tr><th>Forma de pagamento</th><th>Despesas</th><th>Valor</th></tr></thead>
              <tbody>
                <% var nomesFormaPagamento = { dinheiro: 'Dinheiro', pix: 'Pix', cartao: 'Cartão' }; %>
                <% porForma.forEach(function(f) { %>
                  <tr>
                    <td><%= nomesFormaPagamento[f.forma_pagamento] || f.forma_pagamento %></td>
                    <td><%= f.total_despesas %></td>
                    <td>R$ <%= Number(f.valor_total).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="painel">
          <div class="painel-titulo">Detalhe das despesas (<%= detalhe.length %>)</div>
          <% if (detalhe.length === 0) { %>
            <div class="vazio-lista">Nenhuma despesa nesse período.</div>
          <% } else { %>
            <div class="painel-tabela-rolagem">
            <table>
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Descrição</th>
                  <th>Para onde foi</th>
                  <th>Motivo</th>
                  <th>Saiu de</th>
                  <th>Valor</th>
                  <th>Lançado por</th>
                </tr>
              </thead>
              <tbody>
                <% var nomesFormaPagamento2 = { dinheiro: 'Dinheiro', pix: 'Pix', cartao: 'Cartão' }; %>
                <% detalhe.forEach(function(d) { %>
                  <tr>
                    <td class="texto-suave"><%= new Date(d.criado_em).toLocaleString('pt-BR') %></td>
                    <td><%= d.descricao %></td>
                    <td class="texto-suave"><%= d.destino || '—' %></td>
                    <td class="texto-suave"><%= d.motivo || '—' %></td>
                    <td><%= nomesFormaPagamento2[d.forma_pagamento] || d.forma_pagamento %></td>
                    <td><strong>R$ <%= Number(d.valor).toFixed(2) %></strong></td>
                    <td class="texto-suave"><%= d.registrado_por || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
