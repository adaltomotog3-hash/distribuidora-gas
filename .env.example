# Copie este arquivo para ".env" e preencha os valores

# URL de conexão do banco Postgres (o Render te dá isso automaticamente)
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Frase secreta usada para proteger o login (troque por qualquer texto único)
SESSION_SECRET=troque-esta-frase-por-algo-so-seu

# Senha do usuário admin criado na primeira vez que o sistema rodar
ADMIN_PASSWORD=admin123

PORT=3000
