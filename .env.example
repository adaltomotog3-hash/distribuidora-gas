# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# Banco de dados (Postgres)
# postgresql://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL=

# Porta do sistema (padrão 3001)
PORT=3001

# Segredos do sistema — cada um deve ser uma frase LONGA, aleatória e diferente.
# Para gerar um valor forte, rode:   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=

# Chave que criptografa os segredos guardados no banco (chave de API do serviço de
# boleto, código CSC da nota fiscal...). Precisa ter EXATAMENTE 64 caracteres
# hexadecimais. Para gerar:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: guarde uma cópia desta chave em local seguro. Sem ela, os segredos já
# salvos no banco não podem mais ser lidos (e o backup do banco sozinho não basta).
SEGREDOS_KEY=
