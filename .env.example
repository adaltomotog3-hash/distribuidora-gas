# Copie este arquivo para ".env" e preencha os valores antes de rodar o sistema.
# O arquivo ".env" nunca deve ser commitado nem enviado por fora — ele fica de
# fora do Git de propósito (veja o .gitignore) porque guarda senha de banco e
# segredos.

# Endereço de conexão do banco Postgres. No Render, copie o "Internal/External
# Database URL" do banco. Rodando local, algo como:
# postgresql://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL=

# Frase longa e aleatória usada para assinar o cookie de sessão do painel
# (login do escritório). Gere uma nova pra cada instalação — nunca reaproveite
# a mesma frase em dois sistemas. Uma forma rápida de gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Frase longa e aleatória usada para assinar o token de login do aplicativo do
# entregador (JWT). Também deve ser única por instalação — gere do mesmo jeito
# que o SESSION_SECRET, com uma frase diferente.
JWT_SECRET=

# Porta em que o servidor sobe. 3001 funciona bem tanto local quanto atrás de
# um túnel Cloudflare; no Render essa variável já vem definida pela própria
# plataforma.
PORT=3001
